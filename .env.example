# Public Supabase values (safe to expose in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://jbyxlxyiimqfrtozpetq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MqWO1UyZ2vKM7RQ4CD73SQ_j41giqD1

# Server-only Supabase key. Prefer a new sb_secret_ key. A legacy service_role
# JWT also works, but must never use the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=replace-in-host-dashboard

# Comma-separated ChatGPT account emails allowed to open /admin.
ADMIN_EMAILS=admin@example.com
ADMIN_LOGIN_EMAIL=admin@admin.com

# PBKDF2 JSON generated by: npm run admin:secrets
ADMIN_PASSWORD_HASH={"salt":"replace","hash":"replace"}
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ENQUIRY_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64

# Generate a long random secret in production. Raw visitor IPs are never stored.
ANALYTICS_SALT=replace-with-a-long-random-secret
